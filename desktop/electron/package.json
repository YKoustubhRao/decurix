{
  "name": "decurix-desktop",
  "productName": "Decurix",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop launcher for Decurix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test main.test.js mobile-access.test.js",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.decurix.desktop",
    "productName": "Decurix",
    "directories": { "output": "../../dist/electron" },
    "files": ["main.js", "mobile-access.js", "preload.js", "loading.html", "package.json"],
    "extraResources": [
      { "from": "build/decurix.exe", "to": "decurix.exe" },
      { "from": "build/decurix-android-arm64", "to": "decurix-android-arm64" },
      { "from": "../../.env.example", "to": ".env.example" }
    ],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
