{
  "name": "decurix-desktop",
  "productName": "Decurix",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for Decurix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test main.test.js mobile-access.test.js public-name.test.js wsl.test.js prepare-windows.test.js windows-runtime.test.js local-models.test.js native-ollama.test.js preload.test.js windows-lan.test.js gated-port.test.js build-watchdog.test.js apk-safe.test.js stack-health.test.js version-floor.test.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dir",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.decurix.desktop",
    "productName": "Decurix",
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "main.js",
      "mobile-access.js",
      "public-name.js",
      "windows-lan.js",
      "gated-port.js",
      "preload.js",
      "loading.html",
      "package.json",
      "windows-runtime.js",
      "local-models.js",
      "build-watchdog.js",
      "stack-health.js",
      "version-floor.js"
    ],
    "extraResources": [
      {
        "from": "../../.env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "extraResources": [
        {
          "from": "build/stack",
          "to": "stack"
        },
        {
          "from": "build/wsl",
          "to": "wsl"
        },
        {
          "from": "build/cloudflared.exe",
          "to": "cloudflared.exe"
        }
      ]
    },
    "mac": {
      "target": "dir",
      "icon": "icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extraResources": [
        {
          "from": "build/stack",
          "to": "stack"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility",
      "extraResources": [
        {
          "from": "build/stack",
          "to": "stack"
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
