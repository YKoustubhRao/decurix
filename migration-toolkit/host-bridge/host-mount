#!/usr/bin/env bash
# host-mount: Mount host machine filesystem onto the Linux VM using SSHFS (Zero storage duplication)
set -euo pipefail

HOST_TUNNEL_PORT="${HOST_TUNNEL_PORT:-2222}"
HOST_USER="${HOST_USER:-$USER}"
MOUNT_POINT="${1:-/mnt/host}"

mkdir -p "${MOUNT_POINT}"
if mountpoint -q "${MOUNT_POINT}"; then
    echo "Already mounted at ${MOUNT_POINT}."
    exit 0
fi

echo "Detecting host OS..."
HOST_OS=$(ssh -F /dev/null -p "${HOST_TUNNEL_PORT}" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "${HOST_USER}@127.0.0.1" "uname -s 2>/dev/null || echo Windows" 2>/dev/null | tr -d '\r\n')

REMOTE_PATH="."
if [[ "$HOST_OS" =~ Windows ]] || [[ "$HOST_OS" =~ MINGW ]] || [[ "$HOST_OS" =~ CYGWIN ]]; then
    REMOTE_PATH="C:\\"
fi

echo "Mounting host filesystem (${HOST_OS}) to ${MOUNT_POINT} over reverse tunnel..."
sshfs -p "${HOST_TUNNEL_PORT}" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "${HOST_USER}@127.0.0.1:${REMOTE_PATH}" "${MOUNT_POINT}"
echo -e "\033[32m✓ Host mounted at ${MOUNT_POINT}! Access your host files directly without duplicating storage.\033[0m"

