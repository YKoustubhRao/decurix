# Decurix's browser launch flags. Sourced by the desktop's browser launcher
# (agent/chromium-browser, installed as /usr/bin/chromium-browser - Google
# Chrome behind it, see agent/install-browser.sh) every time it starts, from
# ~/.chromium-browser.init - agent/start_agent_terminal.sh reinstalls it
# there on every desktop start, because /home/headless is a persistent
# volume and a copy baked into the image only ever reaches new desktops.
#
# The base image hardcodes --no-sandbox, which is what put the "You are
# using an unsupported command-line flag: --no-sandbox" bar across the top
# of every browser window. The sandbox was off because it could not work:
# Docker's default seccomp profile forbids the namespace syscalls it is
# built from. Desktops are now created with a profile that allows them
# (internal/desktop/sandbox.go), so the flag is only added back when this
# particular container really cannot create the namespaces - a desktop
# created before that change, or a Docker daemon without seccomp - where
# the browser would otherwise refuse to start at all.

# --remote-debugging-port is how the agent's action layer reads and works
# web pages (decurix_agent/computer/cdp.py): Chromium's own accessibility tree
# and input events over DevTools. It binds 127.0.0.1 only, inside a container
# that publishes no ports - but any process in this desktop can drive the
# browser through it, the same trust the agent's shell already has.
# --no-default-browser-check: the "not your default browser" bar is one more
# thing between an agent and the page it was asked to use.
# Chrome reads only the last of a repeated --disable-features, so there is one
# list, and one assignment (a second, overriding one used to make the first dead).
# --hide-crash-restore-bubble: a desktop stopped by idle-pause leaves the profile
#   marked as crashed, and the "Restore pages?" bubble takes the keyboard.
# --renderer-process-limit / --disk-cache-*: a desktop has 1-2 vCPUs and ~2.5 GB;
#   the cache lives in /tmp so it never fills the persistent home volume.
# Not set on purpose: MemorySaverMode (it discards background tabs - a half-filled
#   ERP form in another tab) and a V8 heap cap (ERP single-page apps need more).
CHROMIUM_FLAGS="--disable-gpu --start-maximized --remote-debugging-port=9222 --password-store=basic --no-default-browser-check --no-first-run --disable-breakpad --hide-crash-restore-bubble --renderer-process-limit=2 --disk-cache-dir=/tmp/chromium-cache --disk-cache-size=67108864 --disable-features=AudioServiceOutOfProcess,Translate,AutofillServerCommunication,OptimizationHints,MediaRouter --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings --mute-audio"

# The warning bar is left alone in that case: the browser really is
# running unsandboxed there, and hiding that would be a lie.
if ! unshare --user --map-root-user --pid --net --fork true >/dev/null 2>&1; then
    CHROMIUM_FLAGS="--no-sandbox $CHROMIUM_FLAGS"
fi

# A crashing browser process must not leave a core dump behind. Launched
# from the XFCE menu, Chromium's working directory is ~/Desktop, and a
# crashing utility process there used to drop a ~50 MB core.<pid> onto the
# desktop every fifteen seconds.
ulimit -c 0 2>/dev/null
