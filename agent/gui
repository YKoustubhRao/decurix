#!/bin/sh
# The `gui` command: see and use this desktop's screen (decurix_agent/computer).
# Installed as /usr/local/bin/gui by the desktop Dockerfiles, so every engine's
# shell commands reach the same action layer the agent itself uses.
#
# The command is handed to the desktop's gui daemon (computer/daemon.py), which
# has the screen stack imported already; gui_client.py runs it here, as
# `python3 -m decurix_agent.computer`, when there is no daemon or it does not
# take the command. Output and exit codes are the same either way.
# DECURIX_GUI_DAEMON=off always runs it here.
export PYTHONPATH="/opt${PYTHONPATH:+:$PYTHONPATH}"
client=/opt/decurix_agent/computer/gui_client.py
if [ -f "$client" ] && [ "${DECURIX_GUI_DAEMON:-}" != "off" ]; then
    exec python3 -I -S "$client" "$@"
fi
exec python3 -m decurix_agent.computer "$@"
