#!/bin/sh
# The `office` command: read documents and update workbooks from a shell
# (decurix_agent/tools/office.py) - the same code the azure harness's tools run,
# for the engines that work through shell commands.
# The office venv's python when the image has one (it holds python-pptx): the desktop session's PATH does not name it.
py=python3
[ -x /opt/office-venv/bin/python3 ] && py=/opt/office-venv/bin/python3
PYTHONPATH="/opt${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m decurix_agent.tools.office "$@"
