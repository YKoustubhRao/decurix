#!/bin/sh
# The `office` command: read documents and update workbooks from a shell
# (decurix_agent/tools/office.py) - the same code the azure harness's tools run,
# for the engines that work through shell commands.
# The system python3: it holds the worker libraries (python-pptx among them) since the image dropped its office venv.
PYTHONPATH="/opt${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m decurix_agent.tools.office "$@"
