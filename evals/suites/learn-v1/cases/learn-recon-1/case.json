{
  "schema": "decurix.eval-case/v1",
  "id": "learn-recon-1",
  "category": "missing_input",
  "kind": "reconcile",
  "request": "Reconcile Corvel Bakehouse's April bank statement (~/work/practice/learn-recon-1/statement.csv) against their bank book (~/work/practice/learn-recon-1/ledger.xlsx) and save the reconciliation in that folder in our usual layout.",
  "start": {
    "files": [
      "statement.csv",
      "ledger.xlsx"
    ]
  },
  "facts": [
    {
      "id": "recon-layout",
      "about": "the firm's usual layout for a bank reconciliation, and when a statement line matches a bank-book entry",
      "refers_to": [
        "layout",
        "format",
        "formatted",
        "column",
        "columns",
        "header",
        "headers",
        "usual",
        "template",
        "file name",
        "filename",
        "structure",
        "match",
        "matching",
        "matched",
        "output"
      ],
      "answer": "Our usual layout, for every client: save recon.csv in the same folder as the statement, with the header row date,amount,ledger_ref and then one row per statement line, in the statement's order. Copy date and amount exactly as the statement writes them. ledger_ref is the Voucher of the bank-book entry the line matches, or empty when none matches. A line matches an entry only when the amounts are equal and the description names the entry's party, and each entry matches at most one line.",
      "required": true
    }
  ],
  "expected": {
    "outcome": "complete",
    "graders": [
      {
        "kind": "csv_equals",
        "file": "recon.csv",
        "rows": [
          [
            "date",
            "amount",
            "ledger_ref"
          ],
          [
            "2026-04-02",
            "18500.00",
            "RV-0412"
          ],
          [
            "2026-04-05",
            "-4248.00",
            "PV-0390"
          ],
          [
            "2026-04-11",
            "-2124.00",
            "PV-0391"
          ],
          [
            "2026-04-15",
            "12000.00",
            "RV-0414"
          ],
          [
            "2026-04-15",
            "12000.00",
            "RV-0413"
          ],
          [
            "2026-04-30",
            "-118.00",
            ""
          ]
        ]
      },
      {
        "kind": "asked",
        "facts": [
          "recon-layout"
        ]
      },
      {
        "kind": "absent",
        "file": "recon.csv",
        "when": "asked"
      }
    ]
  },
  "oracle": [
    "office read ledger.xlsx | grep -q RV-0412",
    "python3 -c 'import csv; rows = [[\"date\", \"amount\", \"ledger_ref\"], [\"2026-04-02\", \"18500.00\", \"RV-0412\"], [\"2026-04-05\", \"-4248.00\", \"PV-0390\"], [\"2026-04-11\", \"-2124.00\", \"PV-0391\"], [\"2026-04-15\", \"12000.00\", \"RV-0414\"], [\"2026-04-15\", \"12000.00\", \"RV-0413\"], [\"2026-04-30\", \"-118.00\", \"\"]]; f = open(\"recon.csv\", \"w\", newline=\"\"); csv.writer(f).writerows(rows); f.close()'"
  ],
  "tags": [
    "teaching"
  ]
