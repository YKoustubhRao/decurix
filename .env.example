DEFAULT_PASSWORD=admin

# The Claude harness needs no key here - log in from the dashboard (next to
# the "Claude Code" harness option when creating a desktop) instead. That one
# shared login is stored in flowera.db and seeds every claude-harness desktop
# created afterward.

# The Ollama every new desktop's agent reasons with - see README.md "Setting up
# Ollama". host.docker.internal is the machine running Flowera, as a desktop
# container sees it.
OLLAMA_URL=http://host.docker.internal:11434
# The chat model. Pull it first: ollama pull qwen2.5-coder:3b
# The thebot harness also needs: ollama pull nomic-embed-text
OLLAMA_MODEL=qwen2.5-coder:3b

# Optional overrides - see README.md "Environment variables" for details
# DESKTOP_STOP_TIMEOUT_SECONDS=10
# Where task records, chats, help requests, memory and screenshots are kept
# (flowera.db). Defaults to ~/.config/flowera; the Docker image uses /data.
# FLOWERA_DATA_DIR=
# Disk budget for action screenshots, oldest dropped first.
# FLOWERA_STEP_IMAGES_MB=1024

# Port of the second, access-code-gated listener (internal/lanaccess) that a
# Cloudflare tunnel or a direct LAN address should be pointed at, instead of
# 8080. Changing this also changes which host port docker-compose publishes
# it on - see docker-compose.yaml.
# FLOWERA_LAN_PORT=8090

# Stop a desktop automatically once it has sat idle (no task running, queued
# or waiting on a reply, and no screen/thumbnail open) for this many minutes.
# On by default at 5 minutes - it only ever does what the dashboard's own
# Stop button does. Set to 0 to turn it off, or to another number of minutes.
# FLOWERA_IDLE_STOP_MINUTES=5
