DEFAULT_PASSWORD=admin

# The Claude harness needs no key here - log in from the dashboard (next to
# the "Claude Code" harness option when creating a desktop) instead. That one
# shared login is stored in decurix.db and seeds every claude-harness desktop
# created afterward.

# The Ollama or OpenAI/vLLM server every new desktop's agent reasons with.
# - For local Ollama: http://host.docker.internal:11434
# - For external vLLM or llama-server (OpenAI-compatible): http://<host>:8000/v1
# host.docker.internal is the machine running Decurix, as a desktop container sees it.
OLLAMA_URL=http://host.docker.internal:11434
# The chat model. "auto" (or leave it unset) lets Decurix choose the smartest
# model that fits this computer: 80% of the memory and CPU (and GPU) that is
# free right now, after everything else running on it. It picks among the
# models the Ollama server already has and shows the choice at the top left of
# the app. Name a model instead to pin it, e.g. OLLAMA_MODEL=qwen2.5-coder:3b
# (ollama pull it first). Only applies when the Ollama server runs on this
# machine.
# The thebot harness also needs: ollama pull nomic-embed-text
OLLAMA_MODEL=auto

# Inference Performance Tuning:
# Pin Ollama CPU inference threads to physical cores (e.g., 4 on a 4-core/8-thread CPU)
# to avoid hyperthreading cache thrashing. Defaults automatically to physical cores.
# OLLAMA_NUM_THREAD=4
# Quantize KV cache to q8_0 to halve memory bandwidth pressure on CPU inference (default: q8_0)
# OLLAMA_KV_CACHE_TYPE=q8_0
# Enable Flash Attention in llama.cpp backend (default: 1)
# OLLAMA_FLASH_ATTENTION=1
# Batch token evaluation size for prompt processing (default: 512)
# OLLAMA_NUM_BATCH=512

# Optional overrides - see README.md "Environment variables" for details
# DESKTOP_STOP_TIMEOUT_SECONDS=10
# Where task records, chats, help requests, memory and screenshots are kept
# (decurix.db). Defaults to ~/.config/decurix; the Docker image uses /data.
# DECURIX_DATA_DIR=
# Disk budget for action screenshots, oldest dropped first.
# DECURIX_STEP_IMAGES_MB=1024

# Port of the second, access-code-gated listener (internal/lanaccess) that a
# Cloudflare tunnel or a direct LAN address should be pointed at, instead of
# 8080. Changing this also changes which host port docker-compose publishes
# it on - see docker-compose.yaml.
# DECURIX_LAN_PORT=8090
# Desktop public link: cloudflare (default), localhost-run, or auto to try
# Cloudflare then the free localhost.run SSH tunnel if the link cannot be
# reached. No account/domain needed. localhost.run needs
# the OpenSSH client (included in current Windows installations).
# DECURIX_TUNNEL_PROVIDER=cloudflare

# Stop a desktop automatically once it has sat idle (no task running, queued
# or waiting on a reply, and no screen/thumbnail open) for this many minutes.
# On by default at 5 minutes - it only ever does what the dashboard's own
# Stop button does. Set to 0 to turn it off, or to another number of minutes.
# DECURIX_IDLE_STOP_MINUTES=5

# Host filesystem mount paths for application & session discovery (WSL/Linux):
# DECURIX_HOST_MNT_C=/mnt/c
# DECURIX_HOST_HOME=/home

# By default, browsers (Edge, Chrome, Brave) start with a fresh, clean profile
# and do not copy over your personal browser data from the host. Set to 1 if you
# explicitly want to seed the private desktop's browser with your host profile.
# DECURIX_COPY_BROWSER_PROFILE=0

# Email triggers (the Email page): how often each connected mailbox is
# checked, in seconds. At least 15.
# DECURIX_MAIL_POLL_SECONDS=60

# While a mailbox is watched or a schedule is waiting, this machine is kept
# from going to sleep on its own (nothing runs while it sleeps). It is
# released as soon as nothing needs it. Closing a laptop's lid still sleeps
# it; email that arrived meanwhile is picked up on waking. 0 turns this off.
# DECURIX_KEEP_AWAKE=1

# Hosted models (Claude, Azure OpenAI) are not set here: pick one in the
# dashboard's "New desktop" dialog and type its key there. The control plane
# keeps keys sealed in its database and desktops never hold them.

# Sending the Outbox's emails: the SMTP server is derived from the mailbox's
# IMAP host (imap.gmail.com -> smtp.gmail.com:465); set these to override.
# DECURIX_SMTP_HOST=
# DECURIX_SMTP_PORT=465

# Windows desktop app: workers/control plane in WSL; Ollama native on Windows.
# The runtime installs in the background on first startup. The left sidebar
# Host locally switch scans resources, downloads a suitable model and loads it.
# Switching off unloads inference and deletes Decurix-managed model files.
# The runtime stays installed. Hosting is remembered in local-hosting.json.
# Remote OLLAMA_URL values are preserved. 0 keeps the legacy Linux model server.
# DECURIX_WINDOWS_NATIVE_OLLAMA=1
# WSL defaults: a ceiling of half of physical RAM, all
# logical processors, 2-8 GB swap, and a 256 GB expandable disk for NEW distros.
# Existing .wslconfig values are preserved unless explicitly overridden here.
# These are GLOBAL WSL limits, shared by every distro, including Docker Desktop.
# DECURIX_WSL_MEMORY_MB=16384
# DECURIX_WSL_CPUS=8
# DECURIX_WSL_SWAP_MB=4096
# DECURIX_WSL_DISK_GB=256
# Alternative: RAM excluded from the WSL ceiling. This is not the model budget.
# DECURIX_WINDOWS_RESERVE_MB=16384
# Per-worker limits (Windows app defaults: 2 logical CPUs, 2048 MB RAM).
# DECURIX_DEFAULT_DESKTOP_CPUS=2
# DECURIX_DEFAULT_DESKTOP_MEMORY_MB=2048
# Minimum actual free disk space before image/model downloads and startup (GB).
# DECURIX_MIN_DISK_FREE_GB=10
# WSL NAT discovers the private Windows gateway for native Ollama on port 11435.
# For mirrored networking, supply a local Windows IPv4 address reachable from
# Linux. The model API has no authentication: use a private adapter.
# DECURIX_WINDOWS_OLLAMA_HOST=172.28.0.1
# Multiple workers share queued inference. Extra parallel contexts need RAM/VRAM.
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=1
# Native model storage may be moved to a Windows disk with more free space.
# Decurix uses a disposable decurix-managed subfolder under this custom path.
# OLLAMA_MODELS=D:\Decurix\models

# Native Windows model selection uses live Windows RAM, CPU load and GPU
# measurements with the existing chooser. Use OLLAMA_MODEL=auto to enable it;
# an explicit model name remains pinned. No fixed 4 GB startup reserve applies.

# A GUI-grounding model: when an agent must click something with no entry in
# the screen's element list (an icon, a canvas, a picture), it describes it -
# gui click --see "the bell icon at the top right" - and this model finds where
# it is, instead of the agent guessing coordinates. Off unless a model is named.
# Measured on this repo's 8 GB CPU-only host (qwen3-vl:2b-instruct): 17 of 18 real
# targets hit at full size, about 6 s a click once loaded (14 of 18 and ~5 s with
# DECURIX_GROUNDER_MAX_SIDE=640), but minutes to load it cold, and it shares the
# Ollama (and its memory) with the chat model.
# Use an -instruct tag: a thinking tag (plain qwen3-vl:2b) thinks instead of answering.
# - Ollama (default API): DECURIX_GROUNDER_MODEL=qwen3-vl:2b-instruct  (ollama pull it)
# - A GPU server speaking the OpenAI API (vLLM serving GTA1-7B, Holo1.5-7B,
#   UI-TARS-1.5-7B or UGround-V1-7B):
#   DECURIX_GROUNDER_API=openai
#   DECURIX_GROUNDER_URL=http://gpu-box:8000/v1
#   DECURIX_GROUNDER_KEY=...           (if the server wants one)
# DECURIX_GROUNDER_MODEL=
# How it writes a position, if its name does not say: norm1000 (Qwen3-VL,
# UGround), qwen25 (Qwen2.5-VL based: GTA1, Holo1.5, UI-TARS), pixels.
# DECURIX_GROUNDER_COORDS=
# Shrink the screen to this many pixels on its longer side before sending it.
# DECURIX_GROUNDER_MAX_SIDE=
